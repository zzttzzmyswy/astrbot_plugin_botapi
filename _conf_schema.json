{
  "host": {
    "description": "botapi 监听地址",
    "type": "string",
    "default": "0.0.0.0"
  },
  "port": {
    "description": "botapi 监听端口",
    "type": "int",
    "default": 9000
  },
  "tokens": {
    "description": "账户注册表（token 列表，auth 严格校验，空=拒连）",
    "type": "list",
    "default": []
  },
  "bindings": {
    "description": "账户→机器人绑定（[{token, platform_id}]，一对一）",
    "type": "list",
    "default": []
  },
  "sessions": {
    "description": "账户会话（[{token, list:[会话]}]）",
    "type": "list",
    "default": []
  }
}
